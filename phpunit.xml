<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- chiave usa e getta, serve solo ai test (non protegge nulla) -->
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- MySQL dei test (servizio db di Compose): database separato da quello di sviluppo -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="contabilita_test" force="true"/>
        <!-- anche in $_SERVER: dentro Docker DB_DATABASE è già nell'ambiente e vincerebbe -->
        <server name="DB_DATABASE" value="contabilita_test" force="true"/>
        <!-- spazio di prova dell'onboarding (ADR 0003): un secondo database, separato anche in test -->
        <env name="DB_PROVA_DATABASE" value="contabilita_test_prova" force="true"/>
        <server name="DB_PROVA_DATABASE" value="contabilita_test_prova" force="true"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="GOOGLE_WORKSPACE_DOMAIN" value="associazione.example" force="true"/>
    </php>
</phpunit>
