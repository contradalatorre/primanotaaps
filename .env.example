APP_NAME="Prima nota"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=contabilita
DB_USERNAME=
DB_PASSWORD=

# La durata della sessione (30 giorni) e' fissa in config/session.php.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Accesso con Google (Workspace). Credenziali dalla console Google Cloud: mai nel repository.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve coincidere con l'URI di reindirizzamento autorizzato nella console Google.
GOOGLE_REDIRECT_URI="${APP_URL}/accesso/google/ritorno"
GOOGLE_WORKSPACE_DOMAIN=
