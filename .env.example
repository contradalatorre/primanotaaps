# Copia locale di configurazione: tutti valori finti o vuoti. In produzione e in prova il .env lo scrive
# scripts/scrivi-env.sh dai segreti di GitHub (vedi docs/pubblicazione.md).
APP_NAME="Prima nota"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Con il percorso /contabilita: il ritorno da Google (GOOGLE_REDIRECT_URI, di serie relativo) ci si appoggia.
APP_URL=http://localhost:8080/contabilita
APP_TIMEZONE=Europe/Rome

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=contabilita
DB_USERNAME=contabilita
DB_PASSWORD=segreto-locale

SESSION_DRIVER=database
CACHE_STORE=database
# Su Aruba non gira nessun worker (ADR 0001): le code vanno in modo sincrono.
QUEUE_CONNECTION=sync

# Accesso con Google. La schermata di consenso OAuth va configurata come in docs/pubblicazione.md: tipo
# Esterno, stato In produzione, mai Interno. In stato Test entrano solo gli utenti di prova elencati a mano.
# Tra gli URI di reindirizzamento autorizzati del client c'e' APP_URL + /accesso/google/ritorno.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=

# Email di chi diventa Amministratore al primo accesso, separate da virgola. Va svuotata dopo l'avvio.
AMMINISTRATORI_INIZIALI=

# Account di emergenza: si generano con "php artisan emergenza:credenziali" (solo in locale).
EMERGENZA_PASSWORD_HASH=
EMERGENZA_TOTP_SECRET=

MIGRAZIONI_TOKEN=

# Posta: senza MAIL_MAILER=smtp le email finiscono nel log. Con Gmail, MAIL_PASSWORD e' una password per le app.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=prima-nota@associazione.example
